# yaml-language-server: $schema=https://raw.githubusercontent.com/Open-CMSIS-Pack/devtools/schemas/projmgr/2.11.0/tools/projmgr/schemas/csolution.schema.json
solution:
  target-types:
    - type: NUCLEO-C562RE
      board: NUCLEO-C562RE:NUC562RE$KR1
      device: STM32C562RET6
  output-dirs:
    tmpdir: project/tmp
    outdir: $SolutionDir()$/build/$Project$.$BuildType$
  generators:
    base-dir: $ProjectDir()$/generated
    options:
      - generator: m95m04_mx2codegen
        path: $ProjectDir()$/generated/parts
      - generator: stm32c5xx_hal_mx2codegen
        path: $ProjectDir()$/generated/hal
      - generator: basic_stdio_mx2codegen
        path: $ProjectDir()$/generated/utilities
      - generator: syscalls_mx2codegen
        path: $ProjectDir()$/generated/utilities
  build-types:
    - type: debug_GCC
      compiler: GCC
    - type: release_GCC
      compiler: GCC
    - type: debug_IAR
      compiler: IAR
    - type: release_IAR
      compiler: IAR
    - type: debug_AC6
      compiler: AC6
    - type: release_AC6
      compiler: AC6
  projects:
    - project: project/c562re_eeprma2_m95m04_eepromrw.cproject.yml
  packs:
    - pack: STMicroelectronics::basic_stdio@2.0.0
    - pack: STMicroelectronics::button_hw-part@2.0.0
    - pack: STMicroelectronics::CMSIS@6.3.0
    - pack: STMicroelectronics::crystal_hw-part@2.1.0
    - pack: STMicroelectronics::esd_hw-part@2.1.0
    - pack: STMicroelectronics::led_hw-part@2.3.0
    - pack: STMicroelectronics::m95m04_part_drivers@1.0.0
    - pack: STMicroelectronics::m95m04-dr_hw-part@2.0.0
    - pack: STMicroelectronics::mcp2562fd_hw-part@2.0.0
    - pack: STMicroelectronics::nucleo-c562re_hw-board@2.0.0
